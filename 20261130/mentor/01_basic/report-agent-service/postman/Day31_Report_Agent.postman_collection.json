          }
        ],
        "url": "{{base_url}}/api/v1/agent/ask",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"보고서 {{report_id}}번의 현재 인덱싱 상태를 알려줘.\",\n  \"category_code\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get('allow_paid_llm') !== 'true') {",
              "  console.warn('유료 LLM 호출을 허용하려면 allow_paid_llm=true 설정');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('completed',()=>pm.expect(pm.response.json().status).to.eql('completed'));",
              "pm.test('observed tools',()=>{const x=pm.response.json();const found=x.tool_trace.filter(t=>t.status==='found').map(t=>t.tool);pm.expect(found).to.include.members([\"lookup_status\"]);pm.expect(x.validation.required_tools_observed).to.eql(true);});",
              "pm.test('status-only sources empty',()=>pm.expect(pm.response.json().sources).to.be.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "T07 보고서 {{report_id}}번의 핵심 내용과 현재 인덱싱 상태를 알려줘.",
