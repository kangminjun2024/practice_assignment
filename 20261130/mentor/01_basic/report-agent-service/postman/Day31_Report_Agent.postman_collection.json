{
  "info": {
    "name": "Day31 Report Agent Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('health 200',()=>pm.response.to.have.status(200));",
              "pm.test('CUDA and configuration only',()=>{const x=pm.response.json();pm.expect(x.gpu).to.eql('cuda:0');pm.expect(x.llm_live_verified).to.eql(false);});"
            ]
          }
        }
      ]
    },
    {
      "name": "T01 보고서 {{report_id}}번의 핵심 내용을 알려줘.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/rag/ask",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"보고서 {{report_id}}번의 핵심 내용을 알려줘.\",\n  \"category_code\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get('allow_paid_llm') !== 'true') {",
              "  console.warn('유료 LLM 호출을 허용하려면 allow_paid_llm=true 설정');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('completed',()=>pm.expect(pm.response.json().status).to.eql('completed'));",
              "pm.test('source ID',()=>pm.expect(pm.response.json().sources.map(s=>String(s.report_id))).to.include(pm.environment.get('report_id')));"
            ]
          }
        }
      ]
    },
    {
      "name": "T02 보고서 {{missing_id}}번의 핵심 내용을 알려줘.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/rag/ask",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"보고서 {{missing_id}}번의 핵심 내용을 알려줘.\",\n  \"category_code\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get('allow_paid_llm') !== 'true') {",
              "  console.warn('부재 ID가 실제 존재하면 유료 호출이 발생할 수 있습니다. allow_paid_llm=true 설정 후 실행하세요.');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('empty',()=>{const x=pm.response.json();pm.expect(x.status).to.eql('insufficient_evidence');pm.expect(x.sources).to.be.empty;});"
            ]
          }
        }
      ]
    },
    {
      "name": "T03 ab",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/rag/ask",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"ab\",\n  \"category_code\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 422',()=>pm.response.to.have.status(422));",
              "pm.test('validation',()=>pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
            ]
          }
        }
      ]
    },
    {
      "name": "T05 보고서 {{report_id}}번의 핵심 내용을 알려줘.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/agent/ask",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"보고서 {{report_id}}번의 핵심 내용을 알려줘.\",\n  \"category_code\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get('allow_paid_llm') !== 'true') {",
              "  console.warn('유료 LLM 호출을 허용하려면 allow_paid_llm=true 설정');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('completed',()=>pm.expect(pm.response.json().status).to.eql('completed'));",
              "pm.test('observed tools',()=>{const x=pm.response.json();const found=x.tool_trace.filter(t=>t.status==='found').map(t=>t.tool);pm.expect(found).to.include.members([\"rag_search\"]);pm.expect(x.validation.required_tools_observed).to.eql(true);});",
              "pm.test('source ID',()=>pm.expect(pm.response.json().sources.map(s=>String(s.report_id))).to.include(pm.environment.get('report_id')));"
            ]
          }
        }
      ]
    },
    {
      "name": "T06 보고서 {{report_id}}번의 현재 인덱싱 상태를 알려줘.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
